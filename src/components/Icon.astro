---
interface Props {
  name: 'check' | 'shield' | 'bolt' | 'chat' | 'calc' | 'car' | 'home' | 'wallet' | 'arrow';
}
const { name } = Astro.props;

const paths: Record<string, string> = {
  check: 'M20 6 9 17l-5-5',
  shield: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  bolt: 'M13 2 3 14h9l-1 8 10-12h-9l1-8z',
  chat: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
  calc: 'M5 3h14v18H5z M8 7h8 M8 11h2 M14 11h2 M8 15h2 M14 15h2',
  car: 'M4 17h16 M5 17v-5l2-5h10l2 5v5 M8 14h.01 M16 14h.01',
  home: 'M3 11 12 3l9 8 M5 10v11h14V10 M10 21v-6h4v6',
  wallet: 'M3 7h18v13H3z M3 7l3-4h12l3 4 M16 13.5h2',
  arrow: 'M5 12h14 M13 6l6 6-6 6',
};
---

<svg
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d={paths[name]}></path>
</svg>
