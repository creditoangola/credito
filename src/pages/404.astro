---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página não encontrada" description="A página que procura não existe." noindex form={false}>
  <section class="section">
    <div class="container">
      <h1>Esta página <em>não existe</em></h1>
      <p>Verifique o endereço ou volte ao início para simular o seu crédito.</p>
      <a class="btn btn--green" href="/">Voltar ao início</a>
    </div>
  </section>
</Layout>
